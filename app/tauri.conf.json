{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Superviser",
  "version": "0.1.0-alpha.1",
  "identifier": "me.aagedal.AgentSuperviser",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/aagedal/Aagedal_Agent_Superviser/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
